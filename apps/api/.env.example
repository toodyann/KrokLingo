# Postgres connection string of the Supabase project
# (Project Settings → Database → Connection string; the pooler on port 6543 works too)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Project URL (Project Settings → API). Access tokens are verified with its public keys (JWKS).
SUPABASE_URL=https://<project-ref>.supabase.co

# Only for projects that still sign tokens with the legacy shared secret (HS256)
# SUPABASE_JWT_SECRET=

# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,https://toodyann.github.io

PORT=8787
